[app]
# App name
title = HS编码
# Package name
package.name = hscode
# Package domain
package.domain = org.test
# Source dir
source.dir = .
# Source include extensions
source.include_exts = py,png,jpg,kv,atlas,json,ttf,mp3,ogg,db
# Requirements
requirements = python3,kivy,pandas
# Source main
source.main = main
# Version
version = 0.1
# Orientation
orientation = portrait

# Android specific
android.api = 30
android.ndk_api = 21
android.accept_sdk_license = True
icon.filename = icon.png
presplash.filename = presplash.png

[buildozer]
# Log level
log_level = 2
